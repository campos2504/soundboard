{
  "manifest_version": 3,
  "name": "Arcade Soundboard Steam Deck",
  "version": "1.0.0",
  "description": "Soundboard Arcade retrô com memes da TV brasileira, MyInstants, SoundButtonsWorld, áudio estéreo e painel lateral integrado ao Chrome.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Arcade Soundboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "tabs",
    "commands"
  ],
  "host_permissions": [
    "https://*.myinstants.com/*",
    "https://*.soundbuttonsworld.com/*"
  ],
  "commands": {
    "stop-all-sounds": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Parar todos os sons ativos do Soundboard"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Abrir o Painel Lateral do Soundboard"
    }
  }
}
